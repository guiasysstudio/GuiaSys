{
  "hosting": {
    "target": "studio-legacy",
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": [
      "firebase.json",
      "firebase.legacy.json",
      ".firebaserc",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      "functions/**",
      "docs/**",
      "tests/**",
      "scripts/**",
      "node_modules/**",
      ".git/**",
      "README.md",
      "package*.json",
      "firebase-debug.log"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://*.googleusercontent.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.cloudfunctions.net https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://viacep.com.br; frame-src 'self' https://*.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me; upgrade-insecure-requests" }
        ]
      },
      {
        "source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/sitemap.xml", "function": { "functionId": "sitemap", "region": "southamerica-east1" } },
      { "source": "/api/projects", "function": { "functionId": "publicProjects", "region": "southamerica-east1" } },
      { "source": "/api/download", "function": { "functionId": "projectDownload", "region": "southamerica-east1" } },
      { "source": "/projetos/**", "destination": "/projeto/index.html" }
    ]
  }
}
