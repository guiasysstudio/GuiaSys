rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function validText(value, minSize, maxSize) {
      return value is string
        && value.size() >= minSize
        && value.size() <= maxSize;
    }

    function validUserDocument(userId) {
      return request.resource.data.keys().hasAll([
          'uid',
          'fullName',
          'email',
          'cpf',
          'birthDate',
          'phone',
          'cep',
          'street',
          'number',
          'complement',
          'neighborhood',
          'city',
          'state',
          'profileComplete',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'cpf',
          'birthDate',
          'phone',
          'cep',
          'street',
          'number',
          'complement',
          'neighborhood',
          'city',
          'state',
          'profileComplete',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && validText(request.resource.data.fullName, 3, 120)
        && request.resource.data.cpf is string
        && request.resource.data.cpf.matches('^[0-9]{11}$')
        && request.resource.data.birthDate is string
        && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{10,11}$')
        && request.resource.data.cep is string
        && request.resource.data.cep.matches('^[0-9]{8}$')
        && validText(request.resource.data.street, 2, 160)
        && validText(request.resource.data.number, 1, 20)
        && request.resource.data.complement is string
        && request.resource.data.complement.size() <= 100
        && validText(request.resource.data.neighborhood, 1, 120)
        && validText(request.resource.data.city, 2, 120)
        && request.resource.data.state is string
        && request.resource.data.state.matches('^[A-Z]{2}$')
        && request.resource.data.profileComplete == true
        && request.resource.data.schemaVersion == 1;
    }

    function validProject(projectId) {
      return request.resource.data.keys().hasAll([
          'slug',
          'name',
          'category',
          'path',
          'visible',
          'featured',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'slug',
          'name',
          'category',
          'path',
          'visible',
          'featured',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.slug == projectId
        && validText(request.resource.data.name, 2, 120)
        && validText(request.resource.data.category, 2, 80)
        && validText(request.resource.data.path, 1, 180)
        && request.resource.data.visible is bool
        && request.resource.data.featured is bool;
    }

    function validNewMessage() {
      return request.resource.data.keys().hasAll([
          'name',
          'email',
          'projectSlug',
          'projectName',
          'message',
          'status',
          'source',
          'userId',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'projectSlug',
          'projectName',
          'message',
          'status',
          'source',
          'userId',
          'createdAt',
          'updatedAt'
        ])
        && validText(request.resource.data.name, 2, 120)
        && validText(request.resource.data.email, 5, 180)
        && request.resource.data.email.matches('^.+@.+\\..+$')
        && validText(request.resource.data.projectSlug, 1, 80)
        && validText(request.resource.data.projectName, 2, 120)
        && validText(request.resource.data.message, 10, 5000)
        && request.resource.data.status == 'new'
        && request.resource.data.source in ['contact', 'project']
        && request.resource.data.userId is string
        && request.resource.data.userId.size() <= 128
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && validUserDocument(userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && validUserDocument(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /projects/{projectId} {
      allow get, list: if isAdmin() || resource.data.visible == true;

      allow create: if isAdmin()
        && validProject(projectId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && validProject(projectId)
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /contactMessages/{messageId} {
      allow create: if validNewMessage();
      allow read: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'read', 'archived']
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
