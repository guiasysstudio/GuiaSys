rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function validText(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }
    function validOptionalText(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }
    function validStringList(value, maxItems) {
      return value is list && value.size() <= maxItems
        && (value.size() == 0 || value[0] is string)
        && (value.size() < 2 || value[1] is string)
        && (value.size() < 3 || value[2] is string)
        && (value.size() < 4 || value[3] is string)
        && (value.size() < 5 || value[4] is string)
        && (value.size() < 6 || value[5] is string)
        && (value.size() < 7 || value[6] is string)
        && (value.size() < 8 || value[7] is string)
        && (value.size() < 9 || value[8] is string)
        && (value.size() < 10 || value[9] is string);
    }
    function validUserDocument(userId) {
      return request.resource.data.keys().hasAll([
          'uid', 'fullName', 'email', 'cpf', 'birthDate', 'phone', 'cep',
          'street', 'number', 'complement', 'neighborhood', 'city', 'state',
          'profileComplete', 'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'cpf', 'birthDate', 'phone', 'cep',
          'street', 'number', 'complement', 'neighborhood', 'city', 'state',
          'profileComplete', 'schemaVersion', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && validText(request.resource.data.fullName, 3, 120)
        && request.resource.data.cpf is string && request.resource.data.cpf.matches('^[0-9]{11}$')
        && request.resource.data.birthDate is string && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[0-9]{10,11}$')
        && request.resource.data.cep is string && request.resource.data.cep.matches('^[0-9]{8}$')
        && validText(request.resource.data.street, 2, 160)
        && validText(request.resource.data.number, 1, 20)
        && validOptionalText(request.resource.data.complement, 100)
        && validText(request.resource.data.neighborhood, 1, 120)
        && validText(request.resource.data.city, 2, 120)
        && request.resource.data.state is string && request.resource.data.state.matches('^[A-Z]{2}$')
        && request.resource.data.profileComplete == true
        && request.resource.data.schemaVersion == 1;
    }
    function validCategories(value) {
      return value is list && value.size() >= 1 && value.size() <= 3
        && value[0] in ['Programa', 'Aplicativo', 'Site']
        && (value.size() < 2 || value[1] in ['Programa', 'Aplicativo', 'Site'])
        && (value.size() < 3 || value[2] in ['Programa', 'Aplicativo', 'Site']);
    }
    function validProject(projectId) {
      return request.resource.data.keys().hasAll([
          'slug', 'name', 'shortDescription', 'fullDescription', 'categories',
          'platforms', 'status', 'version', 'requirements', 'features', 'faq',
          'downloadUrl', 'supportUrl', 'licenseUrl', 'order', 'visible', 'featured',
          'logoUrl', 'logoPath', 'bannerUrl', 'bannerPath', 'gallery',
          'seoTitle', 'seoDescription', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'slug', 'name', 'shortDescription', 'fullDescription', 'categories',
          'platforms', 'status', 'version', 'requirements', 'features', 'faq',
          'downloadUrl', 'supportUrl', 'licenseUrl', 'order', 'visible', 'featured',
          'logoUrl', 'logoPath', 'bannerUrl', 'bannerPath', 'gallery',
          'seoTitle', 'seoDescription', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.slug == projectId
        && request.resource.data.slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$')
        && validText(request.resource.data.name, 2, 120)
        && validOptionalText(request.resource.data.shortDescription, 280)
        && validOptionalText(request.resource.data.fullDescription, 12000)
        && validCategories(request.resource.data.categories)
        && validStringList(request.resource.data.platforms, 10)
        && validOptionalText(request.resource.data.status, 80)
        && validOptionalText(request.resource.data.version, 40)
        && validStringList(request.resource.data.requirements, 10)
        && validStringList(request.resource.data.features, 10)
        && request.resource.data.faq is list && request.resource.data.faq.size() <= 10
        && validOptionalText(request.resource.data.downloadUrl, 1000)
        && validOptionalText(request.resource.data.supportUrl, 1000)
        && validOptionalText(request.resource.data.licenseUrl, 1000)
        && request.resource.data.order is number && request.resource.data.order >= 0 && request.resource.data.order <= 9999
        && request.resource.data.visible is bool && request.resource.data.featured is bool
        && validOptionalText(request.resource.data.logoUrl, 2000)
        && validOptionalText(request.resource.data.logoPath, 500)
        && validOptionalText(request.resource.data.bannerUrl, 2000)
        && validOptionalText(request.resource.data.bannerPath, 500)
        && request.resource.data.gallery is list && request.resource.data.gallery.size() <= 12
        && validOptionalText(request.resource.data.seoTitle, 70)
        && validOptionalText(request.resource.data.seoDescription, 180);
    }
    function validNewMessage() {
      return request.resource.data.keys().hasAll([
          'name', 'email', 'projectSlug', 'projectName', 'message',
          'status', 'source', 'userId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'projectSlug', 'projectName', 'message',
          'status', 'source', 'userId', 'createdAt', 'updatedAt'
        ])
        && validText(request.resource.data.name, 2, 120)
        && validText(request.resource.data.email, 5, 180)
        && request.resource.data.email.matches('^.+@.+\\..+$')
        && validText(request.resource.data.projectSlug, 1, 80)
        && validText(request.resource.data.projectName, 2, 120)
        && validText(request.resource.data.message, 10, 5000)
        && request.resource.data.status == 'new'
        && request.resource.data.source in ['contact', 'project']
        && request.resource.data.userId is string && request.resource.data.userId.size() <= 128
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /admins/{adminId} {
      allow get: if isOwner(adminId);
      allow list, create, update, delete: if false;
    }
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && validUserDocument(userId)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId) && validUserDocument(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /projects/{projectId} {
      allow get, list: if isAdmin() || resource.data.visible == true;
      allow create: if isAdmin() && validProject(projectId)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() && validProject(projectId)
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
    match /contactMessages/{messageId} {
      allow create: if validNewMessage();
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'read', 'archived']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
